# GeoMeasure API — Environment Variables
APP_ENV=development
APP_NAME=GeoMeasure API
API_VERSION=0.1.0
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Upload limits
MAX_SYNC_SIZE_MB=50
MAX_ASYNC_SIZE_MB=500
MAX_FEATURES=10000
SYNC_TIMEOUT_S=30

# Database (SQLite default, swap to PostgreSQL via postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./geomeasure.db

# API Keys (comma-separated; leave empty to disable auth in dev)
API_KEYS=dev-key-12345

# Rate limiting
RATE_LIMIT=100/minute

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
