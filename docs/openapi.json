    "/api/v1/distance": {
      "post": {
        "tags": [
          "Distance"
        ],
        "summary": "Geodesic distance between two points",
        "description": "Compute the geodesic distance and bearing between two WGS84 points.\n\nBody fields:\n- **from**: [lon, lat] of the first point\n- **to**: [lon, lat] of the second point",
        "operationId": "compute_distance_api_v1_distance_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
