    "/api/v1/measure": {
      "post": {
        "tags": [
          "Measurements"
        ],
        "summary": "Measure a geospatial file (synchronous)",
        "description": "Upload a geospatial file and receive measurements synchronously.\n\nFiles up to MAX_SYNC_SIZE_MB (default 50 MB) are processed inline.\nFor larger files use POST /measure/async.",
        "operationId": "measure_sync_api_v1_measure_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_measure_sync_api_v1_measure_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full measurement report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
