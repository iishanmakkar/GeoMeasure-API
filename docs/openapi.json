  "components": {
    "schemas": {
      "AreaValues": {
        "properties": {
          "m2": {
            "type": "number",
            "title": "M2",
            "description": "Square metres"
          },
          "km2": {
            "type": "number",
            "title": "Km2",
            "description": "Square kilometres"
          },
          "ha": {
            "type": "number",
            "title": "Ha",
            "description": "Hectares"
          },
          "acres": {
            "type": "number",
            "title": "Acres",
            "description": "Acres"
          },
          "ft2": {
            "type": "number",
            "title": "Ft2",
            "description": "Square feet"
          },
          "mi2": {
            "type": "number",
            "title": "Mi2",
            "description": "Square miles"
          }
        },
        "type": "object",
        "required": [
          "m2",
          "km2",
          "ha",
          "acres",
          "ft2",
          "mi2"
        ],
        "title": "AreaValues",
        "description": "Area measurements in all supported units.",
        "example": {
          "acres": 304165.5,
          "ft2": 13249305600.0,
          "ha": 123080.0,
          "km2": 1230.8,
          "m2": 1230800000.0,
          "mi2": 475.2
        }
      },
      "Body_measure_async_api_v1_measure_async_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "geodesic"
          },
          "units": {
            "type": "string",
            "title": "Units",
            "default": "metric"
          },
          "source_crs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Crs"
          },
          "repair_geometry": {
            "type": "boolean",
            "title": "Repair Geometry",
            "default": false
          },
          "include_properties": {
            "type": "boolean",
            "title": "Include Properties",
            "default": true
          },
          "simplify_tolerance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simplify Tolerance"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_measure_async_api_v1_measure_async_post"
      },
      "Body_measure_sync_api_v1_measure_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Geospatial file to measure"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "geodesic"
          },
          "units": {
            "type": "string",
            "title": "Units",
            "default": "metric"
          },
          "source_crs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Crs"
          },
          "repair_geometry": {
            "type": "boolean",
            "title": "Repair Geometry",
            "default": false
          },
          "include_properties": {
            "type": "boolean",
            "title": "Include Properties",
            "default": true
          },
          "simplify_tolerance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simplify Tolerance"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_measure_sync_api_v1_measure_post"
      },
      "BoundingBox": {
        "properties": {
          "minx": {
            "type": "number",
            "title": "Minx",
            "description": "Minimum longitude (west)"
          },
          "miny": {
            "type": "number",
            "title": "Miny",
            "description": "Minimum latitude (south)"
          },
          "maxx": {
            "type": "number",
            "title": "Maxx",
            "description": "Maximum longitude (east)"
          },
          "maxy": {
            "type": "number",
            "title": "Maxy",
            "description": "Maximum latitude (north)"
          },
          "width_m": {
            "type": "number",
            "title": "Width M",
            "description": "Width of bounding box in metres"
          },
          "height_m": {
            "type": "number",
            "title": "Height M",
            "description": "Height of bounding box in metres"
          }
        },
        "type": "object",
        "required": [
          "minx",
          "miny",
          "maxx",
          "maxy",
          "width_m",
          "height_m"
        ],
        "title": "BoundingBox",
        "description": "Bounding box with WGS84 coordinates and geodesic dimensions."
      },
      "Centroid": {
        "properties": {
          "lon": {
            "type": "number",
            "title": "Lon"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          }
        },
        "type": "object",
        "required": [
          "lon",
          "lat"
        ],
        "title": "Centroid",
        "description": "Centroid coordinates."
      },
      "DistanceRequest": {
        "properties": {
          "from": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "From",
            "description": "[lon, lat] in WGS84"
          },
          "to": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "To",
            "description": "[lon, lat] in WGS84"
          }
        },
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "title": "DistanceRequest",
        "description": "Request body for POST /distance."
      },
      "DistanceResponse": {
        "properties": {
          "distance_m": {
            "type": "number",
            "title": "Distance M"
          },
          "distance_km": {
            "type": "number",
            "title": "Distance Km"
          },
          "distance_mi": {
            "type": "number",
            "title": "Distance Mi"
          },
          "distance_nmi": {
            "type": "number",
            "title": "Distance Nmi"
          },
          "initial_bearing_deg": {
            "type": "number",
            "title": "Initial Bearing Deg"
          },
          "final_bearing_deg": {
            "type": "number",
            "title": "Final Bearing Deg"
          },
          "from_point": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "From Point",
            "description": "[lon, lat]"
          },
          "to_point": {
            "items": {
